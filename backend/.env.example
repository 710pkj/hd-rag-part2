# 에이전트 백엔드 설정. 이 파일을 .env로 복사해 값을 채운다 (.env는 공유하지 않는다)
# Groq(필수): https://console.groq.com/keys 에서 무료 발급
GROQ_API_KEY=
# Tavily(웹 검색, 선택): https://app.tavily.com 에서 무료 발급. 비워 두면 웹 검색 노드를 건너뜀
TAVILY_API_KEY=
# 벡터 DB(선택): Neon PostgreSQL 접속 주소. 있으면 1단계 검색을 Neon(pgvector)에서 하고, 없거나 접속이 안 되면 FAISS(메모리)
#   팀원에게는 조회만 되는 역할의 주소를 받아 넣는다
DATABASE_URL=
# 벡터 DB를 FAISS로 고정하려면 VECTOR_DB=faiss
VECTOR_DB=
# Part 1 제출 폴더 경로(선택). 비워 두면 프로젝트 안 data/HD_RAG_Part1 을 씀
PART1_DIR=
# 쓸 장치(선택): xpu(Intel Arc) · cuda(NVIDIA) · cpu. 비워 두면 자동
RAG_DEVICE=
# 실행 기록 · 피드백 저장소(선택). 비워 두면 이 PC의 로컬 PostgreSQL(localhost:5433/hdrag), 안 되면 cache_runtime/logs/의 JSONL 파일
LOG_DATABASE_URL=
# Groq 모델(선택). 기본 openai/gpt-oss-120b, 무료 한도에 걸리면 대체 모델로 넘어감
GROQ_MODEL=
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
